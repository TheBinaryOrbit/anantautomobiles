// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model user {
  id       String @id @default(uuid())
  email    String @unique
  phone    String @unique
  password String
  name     String
  role     String @default("USER")

  // deleted flag for soft deletes
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserRoleAssignment[]
}

model BikeModel {
  id        String  @id @default(uuid())
  name      String  @unique
  modelName String?
  brand     String
  category  String
  imageUrl  String
  remark    String?

  // optional fields for more detailed information about the bike model
  engineCapacity Int?
  fuelType       String?
  launchYear     Int?
  mileage        Float?
  weight         Float?

  // price and tax information
  exShowroomPrice  Float?
  rtoCharges       Float?
  insuranceCharges Float?
  otherCharges     Float?
  purchasePrice    Float?

  cgstRate Float @default(0)
  sgstRate Float @default(0)
  igstRate Float @default(0)
  cessRate Float @default(0)

  hsnCode String?

  // deleted flag for soft deletes
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bikes     Bike[]
  saleItems SaleItem[]

  @@map("bike_models")
}

model Bike {
  id String @id @default(uuid())

  engineNumber  String? @unique
  chassisNumber String? @unique
  modelId       String
  color         String

  status BikeStatus @default(AVAILABLE)

  manufactureYear    Int?
  manufactureMonth   Months?
  registrationNumber String? @unique
  isRcArrived        Boolean @default(false)
  isNumberPlateReady Boolean @default(false)

  model BikeModel @relation(fields: [modelId], references: [id])

  // deleted flag for soft deletes
  isDeleted Boolean @default(false)

  // purchase relationship
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]
  sale      Sale?      @relation(fields: [saleId], references: [id])
  saleId    String?

  @@map("bikes")
}

model Purchase {
  id             String   @id @default(uuid())
  purchaseNumber String?  @unique
  supplierId     String
  supplier       supplier @relation(fields: [supplierId], references: [id])

  purchaseDate DateTime @default(now())
  status       String   @default("COMPLETED")

  // bikes added in this purchase
  bikes Bike[]

  notes     String?
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchases")
}

model accessories {
  id String @id @default(uuid())

  name     String
  remark   String?
  price    Float
  imageUrl String
  unit     String // uppercase must be specified (e.g., "PIECE", "SET", "BOX")

  quantityInStock Int

  // deleted flag for soft deletes
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]

  @@map("accessories")
}

model Sale {
  id         String   @id @default(uuid())
  saleNumber String?  @unique
  customerId String
  customer   customer @relation(fields: [customerId], references: [id])

  saleDate DateTime   @default(now())
  status   SaleStatus @default(PENDING)

  // financials (computed from SaleItems, stored for reporting)
  subtotal       Float
  discountAmount Float @default(0)
  taxAmount      Float @default(0)
  totalAmount    Float
  pendingAmount  Float @default(0)
  paidAmount     Float @default(0)

  financeCompany        String?
  financeExecutiveName  String?
  financeExecutivePhone String?

  isPaid        Boolean       @default(false)
  paymentType   paymentType
  paymentMethod paymentMethod

  discountId String?
  discount   Discount? @relation(fields: [discountId], references: [id])

  // insurance / goodlife info
  nomineeName     String?
  nomineeAge      Int?
  nomineeRelation String?

  notes      String?
  invoiceUrl String? // URL to the generated invoice
  isDeleted  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SaleItem[]
  bikes Bike[]

  // old bike exchages
  exchange excahgebikes?

  @@map("sales")
}

model Discount {
  id          String  @id @default(uuid())
  name        String  @unique
  description String? @db.Text
  terms       String? @db.Text // comma separated values

  type      DiscountType
  value     Float
  upToLimit Float?

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@map("discounts")
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  itemType SaleItemType

  // for BIKE items, either specific bike or model/color during PDI
  bikeId String?
  bike   Bike?   @relation(fields: [bikeId], references: [id])

  modelId String?
  model   BikeModel? @relation(fields: [modelId], references: [id])
  color   String?

  accessoryId String?
  accessory   accessories? @relation(fields: [accessoryId], references: [id])

  quantity       Int   @default(1) // always 1 for bikes
  unitPrice      Float // this will be exShowroomPrice
  discountAmount Float @default(0)

  // Tax breakdown
  cgstRate Float @default(0)
  sgstRate Float @default(0)
  igstRate Float @default(0)
  cessRate Float @default(0)

  // Extra charges
  rtoCharges       Float @default(0)
  insuranceCharges Float @default(0)
  otherCharges     Float @default(0)

  taxRate   Float @default(0) // total tax rate (%)
  lineTotal Float // (unitPrice - discountAmount) * quantity * (1 + taxRate) + rto + insurance + other

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sale_items")
}

model supplier {
  id String @id @default(uuid())

  // basic supplier information
  name  String
  email String @unique
  phone String @unique

  companyName  String
  supplierType supplierType

  addressId String
  address   address @relation(fields: [addressId], references: [id])

  // deleted flag for soft deletes
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@map("suppliers")
}

model customer {
  id String @id @default(uuid())

  // basic customer information
  name  String
  phone String @unique

  // optional identification documents
  aadhaarNumber       String?
  panNumber           String?
  dob                 DateTime?
  marriageAnniversary DateTime?

  addressId String
  address   address @relation(fields: [addressId], references: [id])

  // deleted flag for soft deletes
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@map("customers")
}

model address {
  id String @id @default(uuid())

  // common address fields
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers customer[]
  suppliers supplier[]

  @@map("addresses")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRoleAssignment[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model excahgebikes {
  id String @id @default(uuid())

  oldBikeName  String
  oldBikeModel String
  oldBikeBrand String
  oldBikeColor String
  oldBikeYear  Int

  oldBikeEngineNumber  String? @unique
  oldBikeChassisNumber String? @unique

  exchangeValue Float
  notes         String?

  // sale relationship
  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id])

  // checklist for old bike condition
  isOldRCAvailable         Boolean @default(false)
  isNocAvailable           Boolean @default(false)
  isOwnerDocumentAvailable Boolean @default(false)
  isChallanAvailable       Boolean @default(false)
  isStatmentAvailable      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model ServiceInquiry {
  id            String   @id @default(uuid())
  name          String
  phone         String
  latitude      Float
  longitude     Float
  serviceType   String   // e.g., "Doorstep Service"
  isPaid        String   // "paid" or "free"
  freeServiceId String?  // Optional id if it matches a coupon or booklet

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SalesInquiry {
  id        String   @id @default(uuid())
  fullName  String
  phone     String
  model     String
  city      String
  state     String
  pincode   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SaleStatus {
  PDI
  PENDING // payment not yet received
  CONFIRMED // payment received
  DELIVERED // bike/items handed over
  CANCELLED
  REFUNDED
}

enum SaleItemType {
  BIKE
  ACCESSORY
}

enum BikeStatus {
  AVAILABLE
  RESERVED
  SOLD
  IN_SERVICE
}

enum supplierType {
  MANUFACTURER
  DEALER
  WHOLESALER
  RETAILER
  OTHER
}

enum Months {
  JANUARY
  FEBRUARY
  MARCH
  APRIL
  MAY
  JUNE
  JULY
  AUGUST
  SEPTEMBER
  OCTOBER
  NOVEMBER
  DECEMBER
}

enum paymentType {
  FULL_PAYMENT
  PARTIAL_PAYMENT_AND_PENDING
  PARTIAL_PAYMENT_AND_PENDING_AND_FINANCE
  DOWN_PAYMENT_AND_FINANCE
  FULL_FINANCE
  OTHER
}

enum paymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  UPI
  CHEQUE
  NET_BANKING
  FINANCE
  OTHER
}
